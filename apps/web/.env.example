# Required in production
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — public app URLs and media
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_URL=http://localhost:8080/uploads
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Optional — third-party clients
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_TENOR_API_KEY=

# WebPush (Phase 18) — public VAPID key matches backend VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry (frontend errors + traces; Phase 0.4 / 22)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.05
NEXT_PUBLIC_APP_ENV=development
# Build-time only — used by @sentry/nextjs to upload source maps; keep server-side
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=Jungle-web

# Axiom (structured logs from Next server + browser web-vitals; Phase 22)
NEXT_PUBLIC_AXIOM_DATASET=Jungle-web
AXIOM_API_TOKEN=

# Cloudflare Turnstile (Phase 21 — public site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stripe public publishable key (Phase 17 — Stars / Ads checkout)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Comma-separated exact paths to hide from main sidebar (routes still work). E.g. /pokes,/nearby
# NEXT_PUBLIC_NAV_EXCLUDED_HREFS=

