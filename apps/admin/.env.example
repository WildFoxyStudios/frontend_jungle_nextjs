# Required in production
BACKEND_URL=http://localhost:8080

# Public site URL (for redirects to public web app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Sentry (admin error tracking)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.1
NEXT_PUBLIC_APP_ENV=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=Jungle-admin

# Axiom (admin server logs)
NEXT_PUBLIC_AXIOM_DATASET=Jungle-admin
AXIOM_API_TOKEN=

# Cloudflare Turnstile (admin login extra check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

